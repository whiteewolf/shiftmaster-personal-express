PORT=3000
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# For HTTPS deployment behind a reverse proxy:
TRUST_PROXY=0
# Set PUBLIC_ORIGIN to your real HTTPS URL when deployed
PUBLIC_ORIGIN=
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
